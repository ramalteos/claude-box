#!/usr/bin/env bash
# claude-box — run the Claude Code CLI inside a container sandbox, one box per
# task, with a fan-out driver for parallel headless runs.
#
#   ./claude-box build                      Build (or rebuild) the image
#   ./claude-box                            Run `claude` on the CURRENT directory
#   ./claude-box <dir>                      Run `claude` on <dir>
#   ./claude-box [<dir>] <args>             Pass args to claude (--resume, --model …)
#   ./claude-box [<dir>] shell              Drop into a bash shell inside the sandbox
#   ./claude-box run -n N [<dir>] <prompt>  Fan out N headless boxes over N worktrees
#   ./claude-box headless [<dir>] --name <box> --prompt-file <f> [--worktree <id> [--branch <b>]]
#                                           One headless box, foreground (orchestrator seam)
#   ./abox <anything>                       Same runner, engine pinned to Apple `container`
#   ./claude-box ps                         List running boxes
#   ./claude-box logs [-f] [--raw] <box>    Show one box's log (rendered from its stream)
#   ./claude-box results <run-id>           Exit code, branch and diffstat per box
#   ./claude-box cleanup <run-id>           Remove that run's worktrees and branches
#   ./claude-box stop <box>|--all           Stop one box, or every box
#   ./claude-box stop --daemon              Stop the container daemon/VM itself
#
#   ./claude-box harness tick|loop|status|memory|ui   Role-agent harness (see
#   ./claude-box role <role> [flags]                  harness/harness.sh and
#                                                     README "Harness")
#
# ENGINE: Docker and Apple `container` are both supported and auto-detected,
# Docker first. Force one with CLAUDE_BOX_ENGINE=docker|container. The two CLIs
# are close but not compatible — `-c` means --cpus on Apple `container` and
# --cpu-shares on Docker, and Docker Desktop cannot bind-mount the host's SSH
# agent socket directly (it exposes it at a fixed magic path instead) — so every
# such difference is funnelled through the engine_* helpers below.
#
# The target dir defaults to $PWD. If the FIRST argument is an existing
# directory, it is used instead and dropped from the args given to claude.
#
# ROOT: $CLAUDE_BOX_ROOT, default $HOME/Documents/GitHub — the folder your repos
# live in. It is mounted at the SAME path relative to $HOME inside the box (so
# /root/Documents/GitHub by default), which is what makes a path identical on
# both sides: `~/Documents/GitHub/<repo>` resolves in the box and out, git
# worktree admin paths stay valid, and an `instance.config.json` `reposRoot` of
# `~/Documents/GitHub` needs no translation. /workspace and /root/workspace stay
# as compatibility symlinks, created by the entrypoint from CLAUDE_BOX_MOUNT.
#
# Mount vs. working dir: if the target is under the root, the WHOLE root is
# mounted (so sibling repos stay reachable) and claude's working dir is set to
# the target's subpath — this is what lets a project's .claude/agents load while
# keeping its sibling clones available. A target outside the root is mounted
# directly at the same container path instead.
#
# Auth is DECOUPLED + PERSISTENT: credentials live in $CONFIG_HOME on the host
# and are bind-mounted in, so you log in once and never again. The host Keychain
# and any Claude Code agents running outside the container are never touched.
set -euo pipefail

IMAGE="${CLAUDE_BOX_IMAGE:-claude-box:latest}"
# Build context, harness modules, roles and template all live next to this script, so
# find where the SCRIPT really is — not where the symlink is. Installing this on PATH
# (ln -s .../claude-box ~/.local/bin/claude-box) is the normal way to use it, and
# `dirname "${BASH_SOURCE[0]}"` alone would resolve to ~/.local/bin and lose everything.
# macOS has no dependable `readlink -f`, hence the loop.
cb_self="${BASH_SOURCE[0]}"
while [ -L "$cb_self" ]; do
  cb_link="$(readlink "$cb_self")"
  case "$cb_link" in
    /*) cb_self="$cb_link" ;;
    *)  cb_self="$(dirname "$cb_self")/$cb_link" ;;
  esac
done
SETUP_DIR="$(cd "$(dirname "$cb_self")" && pwd -P)"

# Persistent, sandbox-only ~/.claude (creds+config), in the macOS app-data dir.
CONFIG_HOME="${CLAUDE_BOX_CONFIG_HOME:-$HOME/Library/Application Support/claude-box}"
# Runner-owned state — box config dirs, logs, run metadata, the pnpm global dir
# and out-of-workspace pnpm store. Deliberately a SIBLING of $CONFIG_HOME, not a
# subdir: $CONFIG_HOME is bind-mounted into the box, and the box has no business
# seeing (or writing to) other boxes' state.
STATE_HOME="${CLAUDE_BOX_STATE:-$HOME/Library/Application Support/claude-box-state}"
NAME_PREFIX="claude-box-"

die() { echo "claude-box: $*" >&2; exit 1; }
note() { echo "claude-box: $*" >&2; }

# --- engine detection and per-engine differences ------------------------------
# ENGINE names the flavour (which flags to use); ENGINE_BIN is what actually gets
# executed. They differ only for the `fake` engine, which records its arguments
# instead of launching anything — that is what lets the harness tests cover intent
# validation, capping, naming and prompt assembly without containers.
ENGINE="" ENGINE_BIN=""
detect_engine() {
  case "${CLAUDE_BOX_ENGINE:-auto}" in
    docker|container)
      ENGINE="$CLAUDE_BOX_ENGINE"
      command -v "$ENGINE" >/dev/null 2>&1 \
        || die "CLAUDE_BOX_ENGINE=$ENGINE but the '$ENGINE' CLI is not on PATH"
      ENGINE_BIN="$ENGINE"
      ;;
    fake)
      ENGINE=fake
      ENGINE_BIN="${CLAUDE_BOX_FAKE_BIN:-$SETUP_DIR/tests/fake-engine.sh}"
      [ -x "$ENGINE_BIN" ] || die "fake engine not executable: $ENGINE_BIN"
      ;;
    auto)
      if command -v docker >/dev/null 2>&1; then ENGINE=docker
      elif command -v container >/dev/null 2>&1; then ENGINE=container
      else die "no container engine found — install Docker or the Apple 'container' CLI"
      fi
      ENGINE_BIN="$ENGINE"
      ;;
    *) die "CLAUDE_BOX_ENGINE must be docker, container, fake or auto" ;;
  esac
}

# Apple `container` puts the sandbox on a vmnet subnet (192.168.64.0/24) behind
# bridge100; reaching the internet needs the HOST to forward those packets out
# en0. A VPN (e.g. AWS Client VPN) zeroes net.inet.ip.forwarding on connect as an
# anti-IP-leak measure and does NOT restore it on disconnect — so the container
# silently loses egress (DNS still resolves locally, so it looks like a hang at
# "Checking connectivity…" / endless API retries). Re-enable it when off. We only
# touch sudo in the broken case, so the common path stays prompt-free.
# Docker Desktop NATs through its own VM and needs none of this.
ensure_ip_forwarding() {
  if [ "$(sysctl -n net.inet.ip.forwarding 2>/dev/null || echo 1)" = "0" ]; then
    note "host IP forwarding is off (VPN?) — re-enabling for container egress…"
    sudo sysctl -w net.inet.ip.forwarding=1 >/dev/null
  fi
}

ensure_daemon() {
  case "$ENGINE" in
    fake) return 0 ;;
    docker)
      docker info >/dev/null 2>&1 && return 0
      if [ -d /Applications/Docker.app ]; then
        note "starting Docker Desktop…"
        open -a Docker
        local i
        for i in $(seq 1 60); do
          docker info >/dev/null 2>&1 && return 0
          sleep 2
        done
      fi
      die "the Docker daemon is not reachable (\`docker info\` fails)"
      ;;
    container)
      if ! container ls >/dev/null 2>&1; then
        note "starting the Apple container daemon…"
        container system start
      fi
      ensure_ip_forwarding
      ;;
  esac
}

# CPU limit. Docker's `-c` is --cpu-shares (a *relative weight*, not a cap), so
# using it there would silently drop the limit.
engine_cpu_args() {
  case "$ENGINE" in
    docker|fake) printf '%s\n' --cpus "$CLAUDE_BOX_CPUS" ;;
    container)   printf '%s\n' -c "$CLAUDE_BOX_CPUS" ;;
  esac
}

# SSH agent. Docker Desktop's VM cannot see a host unix socket through a normal
# bind mount; it re-exports the host agent inside the VM at a fixed path.
engine_ssh_args() {
  [ -n "${SSH_AUTH_SOCK:-}" ] || return 0
  case "$ENGINE" in
    fake)      return 0 ;;
    docker)    printf '%s\n' -v /run/host-services/ssh-auth.sock:/ssh-agent.sock ;;
    container) [ -S "$SSH_AUTH_SOCK" ] && printf '%s\n' -v "$SSH_AUTH_SOCK:/ssh-agent.sock" ;;
  esac
}

engine_build() {
  case "$ENGINE" in
    docker)    docker build -t "$IMAGE" "$SETUP_DIR" ;;
    container) container build -t "$IMAGE" "$SETUP_DIR" ;;
    fake)      "$ENGINE_BIN" build -t "$IMAGE" "$SETUP_DIR" ;;
  esac
}

# Names of running boxes, one per line.
engine_running_boxes() {
  case "$ENGINE" in
    fake)
      cat "${CLAUDE_BOX_FAKE_STATE:-/dev/null}/running" 2>/dev/null || true
      ;;
    docker)
      docker ps --filter "name=^/${NAME_PREFIX}" --format '{{.Names}}' 2>/dev/null || true
      ;;
    container)
      # `container ls` has no name filter; take the first whitespace field.
      container ls 2>/dev/null | awk '{print $1}' | grep "^${NAME_PREFIX}" || true
      ;;
  esac
}

# When the engine thinks a container started, as RFC 3339. The authoritative answer for any
# box — including one whose driver died, or one started before the runner recorded start times.
engine_box_started() {
  case "$ENGINE" in
    docker)    docker inspect -f '{{.State.StartedAt}}' "$1" 2>/dev/null || true ;;
    container) container inspect "$1" 2>/dev/null | sed -n 's/.*"startedAt"[: ]*"\([^"]*\)".*/\1/p' | head -1 ;;
    fake)      : ;;
  esac
}

engine_stop_box() {
  case "$ENGINE" in
    docker)    docker stop "$1" >/dev/null ;;
    container) container stop "$1" >/dev/null ;;
    fake)      "$ENGINE_BIN" stop "$1" >/dev/null ;;
  esac
}

engine_stop_daemon() {
  case "$ENGINE" in
    docker)    osascript -e 'quit app "Docker"' ;;
    container) container system stop ;;
    fake)      : ;;
  esac
}

box_is_running() {
  engine_running_boxes | grep -qx "$1"
}

# --- VM sizing ----------------------------------------------------------------
# Each background agent is another full Claude Code (Node) process plus the tools
# it spawns, so parallel agent fan-out multiplies memory/CPU use. The old 4G cap
# let a few concurrent agents exhaust the VM's RAM (no swap → OOM kill, or
# thrashing) which presents as a freeze. Defaults are derived from the host and
# overridable via env; `run -n N` additionally divides a memory BUDGET across the
# N boxes, because N boxes at the single-box default would oversubscribe the host.
host_mem_gib() {
  local bytes
  bytes="$(sysctl -n hw.memsize 2>/dev/null || echo 0)"
  [ "$bytes" -gt 0 ] 2>/dev/null && echo $((bytes / 1024 / 1024 / 1024)) || echo 8
}
host_cpus() { sysctl -n hw.ncpu 2>/dev/null || echo 4; }

MEM_EXPLICIT=0; [ -n "${CLAUDE_BOX_MEM:-}" ] && MEM_EXPLICIT=1
CPUS_EXPLICIT=0; [ -n "${CLAUDE_BOX_CPUS:-}" ] && CPUS_EXPLICIT=1
HOST_GIB="$(host_mem_gib)"
# Single box: 8 GiB, or a quarter of the host when that is smaller.
DEFAULT_MEM_GIB=8
[ $((HOST_GIB / 4)) -lt "$DEFAULT_MEM_GIB" ] && DEFAULT_MEM_GIB=$((HOST_GIB / 4))
[ "$DEFAULT_MEM_GIB" -lt 2 ] && DEFAULT_MEM_GIB=2
CLAUDE_BOX_MEM="${CLAUDE_BOX_MEM:-${DEFAULT_MEM_GIB}G}"
CLAUDE_BOX_CPUS="${CLAUDE_BOX_CPUS:-4}"
# Share of host RAM a fan-out may claim in total. The rest is left for the host,
# Docker Desktop's own VM overhead, and whatever else is running.
CLAUDE_BOX_FANOUT_MEM_PCT="${CLAUDE_BOX_FANOUT_MEM_PCT:-60}"
CLAUDE_BOX_MIN_BOX_GIB="${CLAUDE_BOX_MIN_BOX_GIB:-3}"

# Sets CLAUDE_BOX_MEM / CLAUDE_BOX_CPUS for one member of an N-box fan-out.
# An explicit env value always wins — this only fills in the default.
size_for_fanout() {
  local n="$1" budget per_box per_cpu
  if [ "$MEM_EXPLICIT" = "0" ]; then
    budget=$((HOST_GIB * CLAUDE_BOX_FANOUT_MEM_PCT / 100))
    per_box=$((budget / n))
    [ "$per_box" -gt "$DEFAULT_MEM_GIB" ] && per_box="$DEFAULT_MEM_GIB"
    if [ "$per_box" -lt "$CLAUDE_BOX_MIN_BOX_GIB" ]; then
      die "$n boxes × ${CLAUDE_BOX_MIN_BOX_GIB}G exceeds the ${CLAUDE_BOX_FANOUT_MEM_PCT}% memory budget of a ${HOST_GIB}G host — lower -n (max $((budget / CLAUDE_BOX_MIN_BOX_GIB))), or set CLAUDE_BOX_MEM to override the guard"
    fi
    CLAUDE_BOX_MEM="${per_box}G"
  fi
  if [ "$CPUS_EXPLICIT" = "0" ]; then
    per_cpu=$(( $(host_cpus) / n ))
    [ "$per_cpu" -lt 1 ] && per_cpu=1
    [ "$per_cpu" -gt 4 ] && per_cpu=4
    CLAUDE_BOX_CPUS="$per_cpu"
  fi
}

# --- target dir → mount root + working dir ------------------------------------
# The root that holds your repos, and where it lands INSIDE the container. The
# container runs as root, so keeping the path identical relative to $HOME means
# `~/Documents/GitHub/<repo>` resolves on both sides. A root outside $HOME has no
# such mapping, so it falls back to /root/workspace.
CLAUDE_BOX_ROOT="${CLAUDE_BOX_ROOT:-$HOME/Documents/GitHub}"
ROOT="$(cd "$CLAUDE_BOX_ROOT" 2>/dev/null && pwd -P || true)"
# Compare against a RESOLVED home: $HOME is often a symlink (macOS /var -> /private/var,
# and /home -> elsewhere on some setups) while `pwd -P` above resolved the root, so an
# unresolved comparison silently loses the parity mapping.
HOME_REAL="$(cd "$HOME" 2>/dev/null && pwd -P || printf '%s' "$HOME")"
if [ -n "$ROOT" ] && [ "${ROOT#"$HOME_REAL"/}" != "$ROOT" ]; then
  CONTAINER_WS="/root/${ROOT#"$HOME_REAL"/}"
else
  CONTAINER_WS="/root/workspace"
fi
TARGET="" MOUNT_SRC="" WORKDIR=""

# Decouple the MOUNT ROOT from the in-container WORKING DIR.
# The root holds sibling repos that reference one another, and a project only
# loads its .claude/agents when claude starts *inside* that dir. So if TARGET is
# anywhere under the root, mount the WHOLE root at $CONTAINER_WS (siblings stay
# reachable) but set -w to TARGET's subpath. Outside the root, mount TARGET
# itself at $CONTAINER_WS.
resolve_target() {
  TARGET="${1:-$PWD}"
  TARGET="$(cd "$TARGET" && pwd -P)"
  if [ -n "$ROOT" ] && { [ "$TARGET" = "$ROOT" ] || [ "${TARGET#"$ROOT"/}" != "$TARGET" ]; }; then
    MOUNT_SRC="$ROOT"
    local rel="${TARGET#"$ROOT"}"      # "" when TARGET == root, else "/<subpath>"
    WORKDIR="$CONTAINER_WS$rel"
  else
    MOUNT_SRC="$TARGET"
    WORKDIR="$CONTAINER_WS"
  fi
}

# host path under the mount root → the path the container sees
to_container_path() {
  local p="$1"
  printf '%s\n' "$CONTAINER_WS${p#"$MOUNT_SRC"}"
}

slug() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '-' | sed 's/^-*//; s/-*$//' | cut -c1-24; }

# --- per-box ~/.claude --------------------------------------------------------
# One shared $CONFIG_HOME was fine for a single interactive box, but N boxes
# writing the same history.jsonl / projects/ / todos/ / shell-snapshots/ clobber
# each other. So: every box gets its OWN config dir, seeded from the shared one,
# and the shared CREDENTIALS FILE is bind-mounted over the top — you still log in
# once, a refreshed token still lands in the shared file, but session state stops
# colliding. The plain interactive box keeps the whole shared dir (so --resume and
# history work as before) unless another box already holds it.
CONFIG_ARGS=()
ISOLATED_CFG=""

seed_config() {
  local dst="$1" item
  mkdir -p "$dst"
  # Config the box should inherit. Session state (projects/, todos/, history,
  # shell-snapshots/, statsig/) is deliberately NOT copied — that is the state
  # whose sharing caused the collisions.
  #
  # Neither are plugins, commands or skills, unless you ask: a role box should be
  # deterministic, and process frameworks are the opposite of that in this context —
  # they add planning gates a headless box cannot answer, and several of them write
  # plan/spec documents into whatever repo they are run in. That is pollution in a
  # product repo. Opt in with CLAUDE_BOX_SEED_PLUGINS=1 when you want them.
  for item in settings.json CLAUDE.md agents; do
    [ -e "$CONFIG_HOME/$item" ] || continue
    [ -e "$dst/$item" ] && continue
    cp -R "$CONFIG_HOME/$item" "$dst/$item" 2>/dev/null || true
  done
  if [ "${CLAUDE_BOX_SEED_PLUGINS:-0}" = "1" ]; then
    for item in plugins commands skills; do
      [ -e "$CONFIG_HOME/$item" ] || continue
      [ -e "$dst/$item" ] && continue
      cp -R "$CONFIG_HOME/$item" "$dst/$item" 2>/dev/null || true
    done
  fi
}

# $1 = box name, $2 = "isolated" | "shared" | "none"
resolve_config_mount() {
  local name="$1" mode="$2" owner
  # "none" is for short-lived housekeeping boxes that never run `claude`.
  if [ "$mode" = none ]; then
    CONFIG_ARGS=()
    return 0
  fi
  if [ "$mode" = shared ]; then
    owner="$(cat "$STATE_HOME/shared-owner" 2>/dev/null || true)"
    if [ -n "$owner" ] && box_is_running "$owner"; then
      note "box '$owner' already holds the shared config — giving this one its own (history/--resume will be separate)"
      mode=isolated
    else
      printf '%s\n' "$name" > "$STATE_HOME/shared-owner"
    fi
  fi
  if [ "$mode" = shared ]; then
    CONFIG_ARGS=(-v "$CONFIG_HOME:/root/.claude")
    return 0
  fi
  ISOLATED_CFG="$STATE_HOME/boxes/$name/claude"
  seed_config "$ISOLATED_CFG"
  CONFIG_ARGS=(-v "$ISOLATED_CFG:/root/.claude")
  # Auth sharing, without sharing session state.
  #
  # The obvious approach — bind-mount the shared .credentials.json ONTO a path inside the
  # per-box config mount — cannot work: Docker Desktop refuses to create a mountpoint
  # inside a virtiofs bind mount ("is outside of rootfs"), so every box died at start with
  # exit 125 the moment a credentials file existed to mount. Instead mount the shared dir
  # at its own path and let the entrypoint link the one file that must be shared.
  #   .credentials.json — symlinked, so a token refresh propagates
  #   .claude.json      — copied, because Claude Code rewrites it constantly and parallel
  #                       boxes sharing it is the collision this isolation exists to avoid
  if [ -f "$CONFIG_HOME/.credentials.json" ]; then
    # Box names repeat between runs, so a per-box config dir outlives its box — and Claude
    # Code, when it refreshes a token, replaces the symlink with a REGULAR file. The
    # entrypoint deliberately never overwrites what a box already has, so that regular file
    # froze one box on the token it happened to hold. Refresh tokens rotate: by the next run
    # some other box had rotated it, this one's copy could no longer refresh, and the box died
    # with "OAuth session expired and could not be refreshed" in 80ms. Carry a newer token
    # back, then drop the copy so the entrypoint links it to the shared login again.
    local mine="$ISOLATED_CFG/.credentials.json"
    if [ -f "$mine" ] && [ ! -L "$mine" ]; then
      if [ "$mine" -nt "$CONFIG_HOME/.credentials.json" ]; then
        # Only a copy that made it back may be dropped: if the cp fails this is the newest
        # refresh token anywhere, and the next run gets another chance to carry it.
        if cp "$mine" "$CONFIG_HOME/.credentials.json" 2>/dev/null; then
          note "carried a newer token back from $name"
          rm -f "$mine"
        else
          note "could not carry the newer token back from $name — keeping its copy"
        fi
      else
        rm -f "$mine"
      fi
      [ -f "$mine" ] || note "relinked $name to the shared login (it was holding its own stale copy)"
    fi
    CONFIG_ARGS+=(-v "$CONFIG_HOME:/root/.claude-host")
  else
    note "no login found in $CONFIG_HOME — run 'claude-box' once and /login before using isolated or headless boxes"
  fi
}

# --- run args: auth, identity, caches -----------------------------------------
# Auth wiring reuses the HOST session; nothing is created or copied in.
RUN_ARGS=()
# Extra engine flags a caller wants on top (see cmd_run's IS_SANDBOX note).
EXTRA_RUN_ARGS=()

build_run_args() {
  local name="$1" cfg_mode="$2"
  RUN_ARGS=(--name "$name" -m "$CLAUDE_BOX_MEM")
  local a
  while IFS= read -r a; do [ -n "$a" ] && RUN_ARGS+=("$a"); done < <(engine_cpu_args)

  resolve_config_mount "$name" "$cfg_mode"
  # Empty-array-safe: a housekeeping box mounts no config at all, and bash 3.2
  # treats "${empty[@]}" as an unbound variable under set -u.
  RUN_ARGS+=(${CONFIG_ARGS[@]+"${CONFIG_ARGS[@]}"})

  # GitHub CLI: the host token lives in the macOS Keychain, which the Linux VM
  # can't read — so a config bind-mount won't carry it. Instead read the EXISTING
  # session token via `gh auth token` (this creates NO new token) and pass it in.
  # An explicitly-exported GH_TOKEN/GITHUB_TOKEN takes precedence.
  local gh_token="${GH_TOKEN:-${GITHUB_TOKEN:-}}"
  if [ -z "$gh_token" ] && command -v gh >/dev/null 2>&1; then
    gh_token="$(gh auth token 2>/dev/null || true)"
  fi
  [ -n "$gh_token" ] && RUN_ARGS+=(-e "GH_TOKEN=$gh_token")

  # Private npm registry (GitHub Packages): pnpm install authenticates via a token
  # that a project/.npmrc references as ${GITHUB_REGISTRY_ACCESS_TOKEN}. Forward
  # the host's value so the substitution resolves. Never created here.
  [ -n "${GITHUB_REGISTRY_ACCESS_TOKEN:-}" ] && \
    RUN_ARGS+=(-e "GITHUB_REGISTRY_ACCESS_TOKEN=$GITHUB_REGISTRY_ACCESS_TOKEN")

  # Your HOST ~/.claude plugins, read-only, on request. Off by default: the host config
  # is not the box's, that decoupling is the point of $CONFIG_HOME, and a plugin written
  # for an interactive session can drag planning gates and plan-document writing into a
  # headless role box. Turn it on when you specifically want a host skill in the box.
  if [ "${CLAUDE_BOX_HOST_PLUGINS:-0}" = "1" ] && [ -d "$HOME/.claude/plugins" ]; then
    RUN_ARGS+=(-v "$HOME/.claude/plugins:/root/.claude/plugins:ro")
  fi

  # An API key, when the box is driven headlessly by something that has one.
  [ -n "${ANTHROPIC_API_KEY:-}" ] && RUN_ARGS+=(-e "ANTHROPIC_API_KEY=$ANTHROPIC_API_KEY")

  # SSH: forward the host agent so signing happens on the host and private keys
  # NEVER enter the sandbox. known_hosts is mounted read-only so host-key
  # verification doesn't prompt. No id_* keys are exposed.
  while IFS= read -r a; do [ -n "$a" ] && RUN_ARGS+=("$a"); done < <(engine_ssh_args)
  [ -n "${SSH_AUTH_SOCK:-}" ] && RUN_ARGS+=(-e "SSH_AUTH_SOCK=/ssh-agent.sock")
  [ -f "$HOME/.ssh/known_hosts" ] && \
    RUN_ARGS+=(-v "$HOME/.ssh/known_hosts:/root/.ssh/known_hosts:ro")

  # Git identity. The host ~/.gitconfig is NOT mounted (it is full of macOS-only
  # paths and credential helpers), which used to leave the box with no identity at
  # all — so commits made in the box failed or landed unattributed. Pass just the
  # identity through, as env, where per-repo config still overrides it.
  local git_name git_email
  git_name="${GIT_AUTHOR_NAME:-$(git config --get user.name 2>/dev/null || true)}"
  git_email="${GIT_AUTHOR_EMAIL:-$(git config --get user.email 2>/dev/null || true)}"
  if [ -n "$git_name" ] && [ -n "$git_email" ]; then
    RUN_ARGS+=(-e "GIT_AUTHOR_NAME=$git_name"    -e "GIT_COMMITTER_NAME=$git_name"
               -e "GIT_AUTHOR_EMAIL=$git_email"  -e "GIT_COMMITTER_EMAIL=$git_email")
  fi

  # Timezone: the image is UTC, the host usually isn't, and an agent that reasons
  # about "today" or reads timestamps should agree with the human next to it.
  local tz="${TZ:-}"
  [ -z "$tz" ] && [ -L /etc/localtime ] && \
    tz="$(readlink /etc/localtime | sed 's|.*/zoneinfo/||')"
  [ -n "$tz" ] && RUN_ARGS+=(-e "TZ=$tz")

  # Forward the update opt-out and TTL to the entrypoint (a fresh env, not the
  # host's). Only passed when set on the host.
  [ -n "${CLAUDE_BOX_SKIP_UPDATE:-}" ] && \
    RUN_ARGS+=(-e "CLAUDE_BOX_SKIP_UPDATE=$CLAUDE_BOX_SKIP_UPDATE")
  [ -n "${CLAUDE_BOX_UPDATE_TTL:-}" ] && \
    RUN_ARGS+=(-e "CLAUDE_BOX_UPDATE_TTL=$CLAUDE_BOX_UPDATE_TTL")

  # pnpm global dir, persisted. Without this, the start-time `pnpm add -g
  # claude-code@latest` re-installs on every single start and throws the result
  # away with the --rm container — N times over for an N-box fan-out. This mount
  # is FIRST on PATH in the image, so the baseline install baked into the image
  # stays as the offline fallback underneath it.
  mkdir -p "$STATE_HOME/pnpm-global"
  RUN_ARGS+=(-v "$STATE_HOME/pnpm-global:/root/pnpm-global")

  # The entrypoint needs the mount path to hang the /workspace and /root/workspace
  # compatibility symlinks off, since the path now follows CLAUDE_BOX_ROOT.
  RUN_ARGS+=(-e "CLAUDE_BOX_MOUNT=$CONTAINER_WS")

  # pnpm store. When the whole root is mounted, put the store inside it: same
  # (bind-mounted) filesystem as node_modules, so pnpm hardlinks instead of
  # copying, and it persists as a real host dir. For a target OUTSIDE the root
  # that would drop a .pnpm-store into the user's own project dir, so those boxes
  # get a shared store from the runner's state dir instead (a separate mount, so
  # pnpm copies rather than links).
  if [ -n "$ROOT" ] && [ "$MOUNT_SRC" = "$ROOT" ]; then
    RUN_ARGS+=(-e "CLAUDE_BOX_STORE_DIR=$CONTAINER_WS/.pnpm-store")
  else
    mkdir -p "$STATE_HOME/pnpm-store"
    RUN_ARGS+=(-v "$STATE_HOME/pnpm-store:/root/.pnpm-store"
               -e "CLAUDE_BOX_STORE_DIR=/root/.pnpm-store")
  fi

  RUN_ARGS+=(${EXTRA_RUN_ARGS[@]+"${EXTRA_RUN_ARGS[@]}"})
  RUN_ARGS+=(-v "$MOUNT_SRC:$CONTAINER_WS" -w "$WORKDIR")
}

# Interactive box in the foreground. Only asks for a TTY when it actually has
# one, so the runner also works from cron, CI or a parent agent.
run_box_fg() {
  local name="$1" cfg_mode="$2"; shift 2
  build_run_args "$name" "$cfg_mode"
  local tty_args=(-i)
  [ -t 0 ] && [ -t 1 ] && tty_args=(-it)
  exec "$ENGINE_BIN" run --rm "${tty_args[@]}" "${RUN_ARGS[@]}" "$IMAGE" "$@"
}

# Detached box: no TTY, output to a log file, exit code recorded on completion.
# Backgrounded here rather than with the engine's own --detach so `logs`,
# `results` and cleanup behave identically on Docker and Apple `container`.
run_box_bg() {
  local name="$1" cfg_mode="$2" log="$3" exit_file="$4"; shift 4
  build_run_args "$name" "$cfg_mode"
  mkdir -p "$(dirname "$log")" "$(dirname "$exit_file")"
  rm -f "$exit_file"
  # When this box started, recorded explicitly. Box names are REUSED, and the log file is
  # truncated rather than recreated, so a file's birth time belongs to whichever box held the
  # name first — which is how the dashboard came to show a six-minute box as running 1h53m.
  date +%s > "$log.started"
  nohup bash -c '
    "$1" run --rm "${@:5}" >"$2" 2>&1
    echo $? >"$3"
  ' _ "$ENGINE_BIN" "$log" "$exit_file" _ "${RUN_ARGS[@]}" "$IMAGE" "$@" >/dev/null 2>&1 &
  disown 2>/dev/null || true
}

# One short-lived box for a housekeeping command (worktree add/remove, diffstat).
# Runs in the container so any path it writes into git metadata is a CONTAINER
# path: git worktree admin files store absolute paths, and the host's
# /Users/<you>/workspace/... does not exist inside the box.
box_exec() {
  local script="$1"
  build_run_args "${NAME_PREFIX}exec-$$" none
  "$ENGINE_BIN" run --rm -e CLAUDE_BOX_SKIP_UPDATE=1 "${RUN_ARGS[@]}" "$IMAGE" bash -lc "$script"
}

unique_name() {
  local base="$1" name="$1" i=2
  while box_is_running "$name"; do name="$base-$i"; i=$((i + 1)); done
  printf '%s\n' "$name"
}

usage() {
  sed -n '2,/^set -euo/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//; $d'
  exit "${1:-0}"
}

# --- subcommands --------------------------------------------------------------
cmd_ps() {
  local names name log started=0
  [ "${1:-}" = "--started" ] && started=1
  names="$(engine_running_boxes)"
  if [ "$started" = 1 ]; then
    # name<TAB>RFC3339 — machine-readable, for the dashboard's elapsed counters.
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      printf '%s\t%s\n' "$name" "$(engine_box_started "$name")"
    done <<< "$names"
    return 0
  fi
  [ -z "$names" ] && { echo "no boxes running"; return 0; }
  printf '%-40s %s\n' BOX LOG
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    log="$STATE_HOME/logs/$name.log"
    [ -f "$log" ] || log="-  (interactive)"
    printf '%-40s %s\n' "$name" "$log"
  done <<< "$names"
}

cmd_logs() {
  local follow=0 raw=0
  while :; do
    case "${1:-}" in
      -f)    follow=1; shift ;;
      --raw) raw=1; shift ;;
      *)     break ;;
    esac
  done
  local name="${1:-}"
  [ -n "$name" ] || die "usage: claude-box logs [-f] <box>"
  case "$name" in "$NAME_PREFIX"*) ;; *) name="$NAME_PREFIX$name" ;; esac
  local log="$STATE_HOME/logs/$name.log"
  [ -f "$log" ] || die "no log for '$name' (interactive boxes write to your terminal; try 'claude-box ps')"
  # Headless boxes write stream-json; render it unless asked for the raw stream.
  local renderer="$SETUP_DIR/harness/render-log.py"
  if [ "$raw" = 0 ] && [ -x "$renderer" ] && head -c 1 "$log" 2>/dev/null | grep -q '{'; then
    if [ "$follow" = 1 ]; then
      # Per-invocation scratch file: two followers sharing one would garble each other.
      local line_file="$STATE_HOME/.render-line.$$"
      tail -n 200 -f "$log" | while IFS= read -r line; do
        printf '%s\n' "$line" > "$line_file"
        python3 "$renderer" "$line_file" 2>/dev/null
      done
      rm -f "$line_file"
    else
      python3 "$renderer" "$log"
    fi
    return 0
  fi
  if [ "$follow" = 1 ]; then tail -f "$log"; else cat "$log"; fi
}

cmd_stop() {
  case "${1:-}" in
    --daemon) engine_stop_daemon; return 0 ;;
    --all)
      local name stopped=0
      while IFS= read -r name; do
        [ -n "$name" ] || continue
        note "stopping $name"; engine_stop_box "$name"; stopped=$((stopped + 1))
      done <<< "$(engine_running_boxes)"
      [ "$stopped" = 0 ] && echo "no boxes running"
      return 0 ;;
    "") die "usage: claude-box stop <box>|--all|--daemon" ;;
    *)
      local name="$1"
      case "$name" in "$NAME_PREFIX"*) ;; *) name="$NAME_PREFIX$name" ;; esac
      box_is_running "$name" || die "no running box named '$name'"
      engine_stop_box "$name"; return 0 ;;
  esac
}

# --- fan-out ------------------------------------------------------------------
# N headless boxes, each on its own git worktree and its own branch, so they can
# attack the same prompt (or the same task from different angles) without fighting
# over the working tree. The worktrees are created FROM INSIDE a box because git
# stores absolute paths in worktree admin files, and the host's path for the mount
# is not the container's.
# When the mount root IS the repo, worktrees land inside it — keep them out of
# `git status` so an agent doesn't try to commit its siblings' work.
exclude_run_dirs() {
  [ "$MOUNT_SRC" = "$TARGET" ] || return 0
  local excl; excl="$(git -C "$TARGET" rev-parse --git-dir)/info/exclude"
  grep -qxF '/.claude-box-runs/' "$excl" 2>/dev/null || {
    mkdir -p "$(dirname "$excl")"; printf '/.claude-box-runs/\n' >> "$excl"; }
}

cmd_run() {
  local n=1 dir="" model="" yes_dir=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -n|--boxes) n="${2:-}"; shift 2 ;;
      -n*)        n="${1#-n}"; shift ;;
      --model)    model="${2:-}"; shift 2 ;;
      --)         shift; break ;;
      -*)         break ;;
      *)
        if [ "$yes_dir" = 0 ] && [ -d "$1" ]; then dir="$1"; yes_dir=1; shift; else break; fi ;;
    esac
  done
  local prompt="$*"
  [ -n "$prompt" ] || die "usage: claude-box run -n <N> [<dir>] <prompt>"
  case "$n" in ''|*[!0-9]*) die "-n needs a number" ;; esac
  [ "$n" -ge 1 ] || die "-n must be at least 1"

  resolve_target "$dir"
  ensure_daemon
  git -C "$TARGET" rev-parse --git-dir >/dev/null 2>&1 \
    || die "'run' gives each box its own git worktree, but $TARGET is not a git repo"
  size_for_fanout "$n"

  local runid meta base_sha base_ref repo_ct wt_root_host wt_root_ct
  runid="r$(date +%Y%m%d-%H%M%S)"
  meta="$STATE_HOME/runs/$runid"; mkdir -p "$meta" "$STATE_HOME/logs"
  base_sha="$(git -C "$TARGET" rev-parse HEAD)"
  base_ref="$(git -C "$TARGET" rev-parse --abbrev-ref HEAD)"
  repo_ct="$(to_container_path "$TARGET")"
  wt_root_host="$MOUNT_SRC/.claude-box-runs/$runid"
  wt_root_ct="$(to_container_path "$wt_root_host")"

  exclude_run_dirs

  note "creating $n worktree(s) from $base_ref ($(printf %.7s "$base_sha"))…"
  local script i
  script="set -e; mkdir -p '$wt_root_ct';"
  for i in $(seq 1 "$n"); do
    script="$script git -C '$repo_ct' worktree add -b 'claude-box/$runid-$i' '$wt_root_ct/$i' '$base_sha' >&2;"
  done
  WORKDIR="$repo_ct"
  box_exec "$script" || die "worktree creation failed"

  # %q, not plain interpolation: these values are sourced back in, and the macOS
  # "Application Support" paths in them contain spaces.
  {
    printf 'runid=%q\n' "$runid";       printf 'engine=%q\n' "$ENGINE"
    printf 'boxes=%q\n' "$n";           printf 'target=%q\n' "$TARGET"
    printf 'repo_container=%q\n' "$repo_ct"
    printf 'base_ref=%q\n' "$base_ref"; printf 'base_sha=%q\n' "$base_sha"
    printf 'wt_root_host=%q\n' "$wt_root_host"
    printf 'wt_root_container=%q\n' "$wt_root_ct"
    printf 'mem=%q\n' "$CLAUDE_BOX_MEM"; printf 'cpus=%q\n' "$CLAUDE_BOX_CPUS"
  } > "$meta/run.env"
  printf '%s\n' "$prompt" > "$meta/prompt.txt"

  # Refresh ONCE for the whole run, then tell the boxes to skip it. Otherwise N
  # boxes start N simultaneous installs into the same bind-mounted pnpm global dir,
  # contending for one store — the race is both slow and pointless.
  if [ "${CLAUDE_BOX_SKIP_UPDATE:-}" != "1" ]; then
    note "refreshing Claude Code once for the whole run…"
    WORKDIR="$repo_ct"
    box_exec claude-box-update > "$meta/update.log" 2>&1 || \
      note "refresh failed (see $meta/update.log) — boxes will use the installed version"
    export CLAUDE_BOX_SKIP_UPDATE=1
  fi

  # Claude Code refuses --permission-mode bypassPermissions when it is running as
  # root — which the box always is — unless IS_SANDBOX=1 says the containment is
  # already there. Set it only for these headless boxes: an interactive box has a
  # human who can answer a prompt, so it keeps the ordinary auto-mode behaviour.
  EXTRA_RUN_ARGS=(-e IS_SANDBOX=1)

  note "launching $n box(es) at $CLAUDE_BOX_MEM / $CLAUDE_BOX_CPUS CPUs each"
  printf '%-32s %-28s %s\n' BOX BRANCH LOG
  for i in $(seq 1 "$n"); do
    local name="$NAME_PREFIX$runid-$i" log claude_args
    log="$STATE_HOME/logs/$name.log"
    WORKDIR="$wt_root_ct/$i"
    # bypassPermissions, not auto: nothing can answer a prompt in a headless box,
    # and the box is the sandbox that makes that safe.
    claude_args=(claude --permission-mode bypassPermissions)
    [ -n "$model" ] && claude_args+=(--model "$model")
    # shellcheck disable=SC2086
    [ -n "${CLAUDE_BOX_RUN_ARGS:-}" ] && claude_args+=($CLAUDE_BOX_RUN_ARGS)
    claude_args+=(-p "$prompt")
    run_box_bg "$name" isolated "$log" "$meta/$i.exit" "${claude_args[@]}"
    {
      printf 'name=%q\n' "$name"; printf 'index=%q\n' "$i"
      printf 'branch=%q\n' "claude-box/$runid-$i"
      printf 'worktree_container=%q\n' "$wt_root_ct/$i"
      printf 'worktree_host=%q\n' "$wt_root_host/$i"
      printf 'log=%q\n' "$log"
    } > "$meta/$i.env"
    printf '%-32s %-28s %s\n' "$name" "claude-box/$runid-$i" "$log"
  done
  echo
  echo "run id: $runid"
  echo "  follow:  ./claude-box logs -f ${NAME_PREFIX}$runid-1"
  echo "  status:  ./claude-box results $runid"
  echo "  tidy up: ./claude-box cleanup $runid"
}

# One headless box for an external orchestrator (claude-graph): one prompt, one
# optional worktree, in the foreground, the box's exit code passed through. The
# orchestrator owns control flow; this owns everything the engine needs to know,
# so the orchestrator never sees a container path or an engine flag.
cmd_headless() {
  local dir="" name="" wt="" branch="" prompt_file="" sys_file="" model="" effort="" remove=0 yes_dir=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --name)               name="${2:-}"; shift 2 ;;
      --worktree)           wt="${2:-}"; shift 2 ;;
      --branch)             branch="${2:-}"; shift 2 ;;
      --prompt-file)        prompt_file="${2:-}"; shift 2 ;;
      --system-prompt-file) sys_file="${2:-}"; shift 2 ;;
      --model)              model="${2:-}"; shift 2 ;;
      --effort)             effort="${2:-}"; shift 2 ;;
      --remove)             remove=1; shift ;;
      -*)                   die "unknown flag for 'headless': $1" ;;
      *) if [ "$yes_dir" = 0 ] && [ -d "$1" ]; then dir="$1"; yes_dir=1; shift
         else die "unexpected argument: $1"; fi ;;
    esac
  done
  local usage="usage: claude-box headless [<dir>] --name <box> --prompt-file <file> [--worktree <id> [--branch <name>]] [--system-prompt-file <file>] [--model <m>] [--effort <e>]  |  [<dir>] --worktree <id> --remove"
  case "$wt"   in *[!A-Za-z0-9._-]*) die "worktree id must match [A-Za-z0-9._-]: '$wt'" ;; esac
  case "$name" in *[!A-Za-z0-9._-]*) die "box name must match [A-Za-z0-9._-]: '$name'" ;; esac
  case "$branch" in *..*|-*|/*|*[!A-Za-z0-9._/-]*) die "branch must match [A-Za-z0-9._/-], no leading - or /, no ..: '$branch'" ;; esac
  [ -n "$branch" ] && [ -z "$wt" ] && die "--branch needs --worktree"

  resolve_target "$dir"
  local repo_ct wt_host="" wt_ct="" meta=""
  repo_ct="$(to_container_path "$TARGET")"
  if [ -n "$wt" ]; then
    git -C "$TARGET" rev-parse --git-dir >/dev/null 2>&1 \
      || die "--worktree needs a git repo, and $TARGET is not one"
    wt_host="$MOUNT_SRC/.claude-box-runs/$wt"
    wt_ct="$(to_container_path "$wt_host")"
    meta="$STATE_HOME/runs/wt-$wt.env"
  fi

  if [ "$remove" = 1 ]; then
    [ -n "$wt" ] || die "--remove needs --worktree <id>"
    [ -z "$name$prompt_file$sys_file" ] || die "--remove takes no --name, prompt or system prompt"
    ensure_daemon
    WORKDIR="$repo_ct"
    box_exec "git -C '$repo_ct' worktree remove --force '$wt_ct' 2>/dev/null; git -C '$repo_ct' worktree prune" \
      || die "worktree removal failed"
    # The in-container remove deletes the tree. A dir still here was never a worktree
    # (a run that died before `worktree add`), so only an EMPTY one is cleared.
    if [ -d "$wt_host" ]; then
      rmdir "$wt_host" 2>/dev/null || die "worktree dir still present after removal: $wt_host"
    fi
    branch="$(sed -n 's/^branch=//p' "$meta" 2>/dev/null)"
    rm -f "$meta"
    note "worktree $wt removed (branch ${branch:-claude-box/$wt} kept)"
    return 0
  fi

  [ -n "$name" ] || die "$usage (--name is required)"
  [ -n "$prompt_file" ] || die "$usage (--prompt-file is required)"
  [ -f "$prompt_file" ] || die "no such prompt file: $prompt_file"
  [ -z "$sys_file" ] || [ -f "$sys_file" ] || die "no such system prompt file: $sys_file"
  ensure_daemon
  type require_login >/dev/null 2>&1 && require_login

  local base
  if [ -n "$wt" ]; then
    if [ -d "$wt_host" ]; then
      # Every later role on the same task reports the base the FIRST one cut from, so
      # the orchestrator's diff stays anchored even when HEAD has moved since.
      # The branch is whatever the FIRST call chose; a later --branch cannot move it.
      branch="$(sed -n 's/^branch=//p' "$meta" 2>/dev/null)"
      [ -n "$branch" ] || branch="claude-box/$wt"
      base="$(sed -n 's/^base=//p' "$meta" 2>/dev/null)"
      [ -n "$base" ] || base="$(git -C "$TARGET" merge-base HEAD "$branch" 2>/dev/null \
                                || git -C "$TARGET" rev-parse HEAD)"
    else
      [ -n "$branch" ] || branch="claude-box/$wt"
      exclude_run_dirs
      base="$(git -C "$TARGET" rev-parse HEAD)"
      WORKDIR="$repo_ct"
      box_exec "set -e; mkdir -p '$(dirname "$wt_ct")'; git -C '$repo_ct' worktree add -b '$branch' '$wt_ct' '$base' >&2" \
        || die "worktree creation failed"
      mkdir -p "$(dirname "$meta")"
      printf 'base=%s\nbranch=%s\n' "$base" "$branch" > "$meta"
    fi
    printf 'worktree=%s\nbranch=%s\nbase=%s\n' "$wt_host" "$branch" "$base"
    WORKDIR="$wt_ct"
  fi

  name="$NAME_PREFIX$name"
  box_is_running "$name" && die "a box named $name is already running — stop it or pick another name"
  printf 'box=%s\n' "$name"
  local claude_args=(claude --permission-mode bypassPermissions --output-format stream-json --verbose)
  [ -n "$model" ]    && claude_args+=(--model "$model")
  [ -n "$effort" ]   && claude_args+=(--effort "$effort")
  [ -n "$sys_file" ] && claude_args+=(--append-system-prompt "$(cat "$sys_file")")
  claude_args+=(-p "$(cat "$prompt_file")")
  # bypassPermissions as root — every box is root — needs IS_SANDBOX to say the
  # containment is already there. Same as `run` and `role`.
  EXTRA_RUN_ARGS=(-e IS_SANDBOX=1)
  run_box_fg "$name" isolated "${claude_args[@]}"
}

cmd_results() {
  local runid="${1:-}"
  [ -n "$runid" ] || die "usage: claude-box results <run-id>"
  local meta="$STATE_HOME/runs/$runid"
  [ -d "$meta" ] || die "unknown run id '$runid'"
  # shellcheck disable=SC1090
  . "$meta/run.env"
  resolve_target "$target"
  ensure_daemon
  echo "run $runid — $boxes box(es) from $base_ref ($(printf %.7s "$base_sha"))"
  echo "prompt: $(head -c 200 "$meta/prompt.txt")"
  echo
  local i name status exit_code script=""
  printf '%-32s %-10s %s\n' BOX STATUS BRANCH
  for i in $(seq 1 "$boxes"); do
    # shellcheck disable=SC1090
    ( . "$meta/$i.env"
      if [ -f "$meta/$i.exit" ]; then
        exit_code="$(cat "$meta/$i.exit")"
        status="exit $exit_code"
      elif box_is_running "$name"; then status="running"
      else status="gone"; fi
      printf '%-32s %-10s %s\n' "$name" "$status" "$branch" )
  done
  echo
  for i in $(seq 1 "$boxes"); do
    # shellcheck disable=SC1090
    . "$meta/$i.env"
    script="$script echo; echo '=== box $i ($branch) ==='; git -C '$worktree_container' --no-pager log --oneline '$base_sha'..HEAD | sed 's/^/  commit /'; git -C '$worktree_container' --no-pager diff --stat '$base_sha' | tail -5; u=\$(git -C '$worktree_container' status --porcelain | wc -l | tr -d ' '); echo \"  uncommitted paths: \$u\";"
  done
  WORKDIR="$repo_container"
  box_exec "$script" || true
}

cmd_cleanup() {
  local runid="" force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -y|--yes) force=1; shift ;;
      *) runid="$1"; shift ;;
    esac
  done
  [ -n "$runid" ] || die "usage: claude-box cleanup [-y] <run-id>"
  local meta="$STATE_HOME/runs/$runid"
  [ -d "$meta" ] || die "unknown run id '$runid'"
  # shellcheck disable=SC1090
  . "$meta/run.env"
  resolve_target "$target"
  ensure_daemon

  local i still=0
  for i in $(seq 1 "$boxes"); do
    ( . "$meta/$i.env"; box_is_running "$name" ) && still=$((still + 1))
  done
  [ "$still" -gt 0 ] && die "$still box(es) of $runid are still running — './claude-box stop --all' first"

  echo "About to permanently delete, for run $runid:"
  echo "  - $boxes git worktree(s) under $wt_root_host, INCLUDING any uncommitted changes in them"
  echo "  - the branches claude-box/$runid-1 … -$boxes (commits on them are lost unless merged elsewhere)"
  echo "  - the per-box config dirs and logs under $STATE_HOME"
  if [ "$force" != 1 ]; then
    if [ -t 0 ]; then
      printf 'Proceed? [y/N] '; local ans; read -r ans
      case "$ans" in y|Y|yes|YES) ;; *) echo "aborted"; return 1 ;; esac
    else
      die "refusing to delete without confirmation — re-run with -y"
    fi
  fi

  local script=""
  for i in $(seq 1 "$boxes"); do
    # shellcheck disable=SC1090
    . "$meta/$i.env"
    script="$script git -C '$repo_container' worktree remove --force '$worktree_container' || true; git -C '$repo_container' branch -D '$branch' || true;"
  done
  WORKDIR="$repo_container"
  box_exec "$script git -C '$repo_container' worktree prune" || true
  for i in $(seq 1 "$boxes"); do
    # shellcheck disable=SC1090
    ( . "$meta/$i.env"; rm -rf "$STATE_HOME/boxes/$name"; rm -f "$log" )
  done
  rmdir "$wt_root_host" 2>/dev/null || true
  rm -rf "$meta"
  note "run $runid cleaned up"
}

# --- main ---------------------------------------------------------------------
mkdir -p "$CONFIG_HOME" "$STATE_HOME/logs" "$STATE_HOME/boxes" "$STATE_HOME/runs"
detect_engine

# The role-agent harness lives in its own file: it is a separate concern from
# running one box, and keeping it out of here keeps both readable.
# shellcheck source=harness/harness.sh
[ -f "$SETUP_DIR/harness/harness.sh" ] && . "$SETUP_DIR/harness/harness.sh"

# The tests source this file to exercise helpers (intent validation, memory assembly,
# locking) directly, without a container and without dispatching.
#
# The sourced check matters as much as the env var: a stray exported CLAUDE_BOX_SOURCE_ONLY
# would otherwise turn every `claude-box` invocation into a silent no-op — which is exactly
# what happened when a test's `VAR=1 . claude-box` leaked (assignments to the `.` builtin
# persist in the calling shell).
if [ "${CLAUDE_BOX_SOURCE_ONLY:-}" = "1" ] && [ "${BASH_SOURCE[0]}" != "$0" ]; then
  return 0
fi

case "${1:-}" in
  -h|--help|help) usage ;;
  harness) shift; cmd_harness "$@"; exit $? ;;
  role)    shift; cmd_role "$@"; exit $? ;;
  build)   ensure_daemon; engine_build; exit $? ;;
  ps)      shift; cmd_ps "$@"; exit 0 ;;
  logs)    shift; cmd_logs "$@"; exit 0 ;;
  stop)    shift; cmd_stop "$@"; exit 0 ;;
  run)     shift; cmd_run "$@"; exit 0 ;;
  headless) shift; cmd_headless "$@"; exit $? ;;
  results) shift; cmd_results "$@"; exit 0 ;;
  cleanup) shift; cmd_cleanup "$@"; exit 0 ;;
esac

# Target dir = current dir, unless the first arg is an existing directory.
DIR=""
if [ -n "${1:-}" ] && [ -d "$1" ]; then DIR="$1"; shift; fi
resolve_target "$DIR"
ensure_daemon

BASE_NAME="$(slug "$(basename "$TARGET")")"
[ -z "$BASE_NAME" ] && BASE_NAME=box
[ -n "${CLAUDE_BOX_NAME:-}" ] && BASE_NAME="$(slug "$CLAUDE_BOX_NAME")"
BOX_NAME="$(unique_name "$NAME_PREFIX$BASE_NAME")"

# Set CLAUDE_BOX_ISOLATE=1 to give even a plain interactive box its own config
# dir (separate history and --resume list, no chance of colliding with another).
CFG_MODE=shared
[ "${CLAUDE_BOX_ISOLATE:-}" = "1" ] && CFG_MODE=isolated

if [ "${1:-}" = "shell" ]; then
  shift
  run_box_fg "$BOX_NAME" "$CFG_MODE" bash "$@"
fi

run_box_fg "$BOX_NAME" "$CFG_MODE" "$@"
