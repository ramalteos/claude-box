#!/usr/bin/env bash
# claude-box pre-push hook — a change reaches a protected branch through a pull request,
# or it does not reach it.
#
# The role definitions already say "open a PR, never merge", and the policy layer denies
# `gh pr merge` and force-pushes. Neither stops `git push origin main`, which is the one
# command that would put unreviewed agent work on your trunk. This does.
#
# Installed image-wide via `git config --global core.hooksPath`, so it applies in every
# repo a box touches with no per-repo setup.
#
# Escape hatch, for a human who means it:
#   CLAUDE_BOX_ALLOW_DIRECT_PUSH=1 git push origin main
set -uo pipefail

[ "${CLAUDE_BOX_ALLOW_DIRECT_PUSH:-}" = "1" ] && exit 0

remote_name="${1:-origin}"

# The default branch as the remote reports it, plus the usual trunk names — a repo whose
# origin/HEAD is not set locally must not become an accidental exception.
default_branch=""
if ref="$(git symbolic-ref --quiet "refs/remotes/${remote_name}/HEAD" 2>/dev/null)"; then
  default_branch="${ref##*/}"
fi
protected="main master trunk develop next production release"
[ -n "$default_branch" ] && protected="$default_branch $protected"

is_protected() {
  local branch="$1" p
  for p in $protected; do
    [ "$branch" = "$p" ] && return 0
  done
  return 1
}

# stdin: <local ref> <local sha> <remote ref> <remote sha>
blocked=""
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [ -n "${remote_ref:-}" ] || continue
  case "$remote_ref" in
    refs/heads/*) ;;
    *) continue ;;                      # tags and notes are not the concern here
  esac
  branch="${remote_ref#refs/heads/}"
  is_protected "$branch" && blocked="$blocked $branch"
done

if [ -n "$blocked" ]; then
  cat >&2 <<MSG

claude-box: refusing to push directly to:$blocked

A protected branch takes changes through a pull request. Push your work to its own
branch and open one:

  git push -u $remote_name HEAD
  gh pr create --fill          # or: gh stack submit, for a chain of PRs

If you are a human who means to do this:
  CLAUDE_BOX_ALLOW_DIRECT_PUSH=1 git push $remote_name <branch>
MSG
  exit 1
fi
